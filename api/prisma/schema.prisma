// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  name      String    @map("nome")
  login     String    @unique
  password  String    @map("senha")
  createdAt DateTime  @default(now()) @map("criado_em")
  updatedAt DateTime? @map("alterado_em")
  Recipe    Recipe[]

  @@map("usuarios")
}

model Recipe {
  id              Int       @id @default(autoincrement())
  name            String    @map("nome")
  preparationTime Int       @map("tempo_preparo")
  portions        Int       @map("porcoes")
  preparationMode String    @map("mode_preparo") @db.Text
  ingredients     String    @map("ingredientes") @db.Text
  createdAt       DateTime  @default(now()) @map("criado_em")
  updatedAt       DateTime? @map("alterado_em")

  user       User     @relation(fields: [userId], references: [id])
  userId     Int      @map("id_usuarios")
  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int      @map("id_categorias")

  @@map("receitas")
}

model Category {
  id     Int      @id @default(autoincrement())
  name   String   @unique @map("nome")
  Recipe Recipe[]

  @@map("categorias")
}
